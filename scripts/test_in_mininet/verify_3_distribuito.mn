h8 timeout 100 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 8804 --duration 95 --pps-min 5 --pps-max 32 --payload-min 200 --payload-max 1400 --burst-prob 0.06 --burst-min 4 --burst-max 12 --sleep-jitter 0.045 &
h3 timeout 100 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 9920 --duration 95 --pps-min 12 --pps-max 38 --payload-min 300 --payload-max 800 --burst-prob 0.02 --burst-min 2 --burst-max 5 --sleep-jitter 0.002 &
