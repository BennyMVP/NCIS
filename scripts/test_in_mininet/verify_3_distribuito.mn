py "import time; time.sleep(1)"
h1 timeout 100 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 8800 --duration 95 --pps-min 5 --pps-max 34 --payload-min 200 --payload-max 1400 --burst-prob 0.06 --burst-min 4 --burst-max 14 --sleep-jitter 0.03 &
