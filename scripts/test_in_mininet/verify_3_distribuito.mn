h9 timeout 100 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 9922 --duration 95 --pps-min 12 --pps-max 38 --payload-min 300 --payload-max 800 --burst-prob 0.02 --burst-min 2 --burst-max 5 --sleep-jitter 0.0025 &
h12 timeout 100 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 9923 --duration 95 --pps-min 11 --pps-max 37 --payload-min 300 --payload-max 800 --burst-prob 0.00 --burst-min 2 --burst-max 5 --sleep-jitter 0.001 &
