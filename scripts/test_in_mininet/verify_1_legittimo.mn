py "print('##############################################################')"
py "print('###  TEST 1 - SOLO TRAFFICO LEGITTIMO                       ###')"
py "print('###  Atteso: NESSUN blocco, tutti i ping 0% loss           ###')"
py "print('##############################################################')"
h4 python3 /tmp/udp_sink.py --ports 8800-8899,9900-9999 > /tmp/h4_sink.log 2>&1 &
py "import time; time.sleep(1)"
h1 timeout 65 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 8800 --duration 60 --pps-min 5 --pps-max 34 --payload-min 200 --payload-max 1400 --burst-prob 0.06 --burst-min 4 --burst-max 14 --sleep-jitter 0.03 &
h2 timeout 65 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 8801 --duration 60 --pps-min 6 --pps-max 38 --payload-min 200 --payload-max 1400 --burst-prob 0.07 --burst-min 4 --burst-max 14 --sleep-jitter 0.035 &
h8 timeout 65 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 8804 --duration 60 --pps-min 5 --pps-max 32 --payload-min 200 --payload-max 1400 --burst-prob 0.06 --burst-min 4 --burst-max 12 --sleep-jitter 0.045 &
py "print('... traffico legittimo in corso, attendo 45s ...')"
sh sleep 45
py "print('--- PING (tutti attesi 0% loss) ---')"
py "print('--- h1 (LEGITTIMO) ---')"
h1 ping -c 3 -W 2 10.0.0.4
py "print('--- h2 (LEGITTIMO) ---')"
h2 ping -c 3 -W 2 10.0.0.4
py "print('--- h8 (LEGITTIMO) ---')"
h8 ping -c 3 -W 2 10.0.0.4
py "print('--- REGOLE DROP (attese: NESSUNA) ---')"
sh ovs-ofctl -O OpenFlow13 dump-flows s1 | grep -i drop
sh ovs-ofctl -O OpenFlow13 dump-flows s2 | grep -i drop
sh ovs-ofctl -O OpenFlow13 dump-flows s3 | grep -i drop
sh ovs-ofctl -O OpenFlow13 dump-flows s4 | grep -i drop
py "print('=== FINE TEST 1 ===')"

