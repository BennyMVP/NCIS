h4 python3 /tmp/udp_sink.py --ports 8800-8899,9900-9999 > /tmp/h4_sink.log 2>&1 &
py "import time; time.sleep(1)"
h1 timeout 75 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 8800 --duration 70 --pps-min 5 --pps-max 34 --payload-min 200 --payload-max 1400 --burst-prob 0.06 --burst-min 4 --burst-max 14 --sleep-jitter 0.03 &
h2 timeout 75 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 8801 --duration 70 --pps-min 6 --pps-max 38 --payload-min 200 --payload-max 1400 --burst-prob 0.07 --burst-min 4 --burst-max 14 --sleep-jitter 0.035 &
h8 timeout 75 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 8804 --duration 70 --pps-min 5 --pps-max 32 --payload-min 200 --payload-max 1400 --burst-prob 0.06 --burst-min 4 --burst-max 12 --sleep-jitter 0.045 &
h3 timeout 75 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 9910 --duration 70 --pps-min 200 --pps-max 420 --payload-min 300 --payload-max 800 --burst-prob 0.18 --burst-min 20 --burst-max 60 --sleep-jitter 0.002 &
py "print('... attacco singolo + sfondo legittimo, attendo mitigazione 30s ...')"
sh sleep 30
py "print('--- PING ---')"
py "print('--- h3 (ATTACCANTE) atteso 100% loss ---')"
h3 ping -c 3 -W 2 10.0.0.4
py "print('--- h1 (LEGITTIMO) atteso 0% loss ---')"
h1 ping -c 3 -W 2 10.0.0.4
py "print('--- h2 (LEGITTIMO) atteso 0% loss ---')"
h2 ping -c 3 -W 2 10.0.0.4
py "print('--- h8 (LEGITTIMO) atteso 0% loss ---')"
h8 ping -c 3 -W 2 10.0.0.4
py "print('--- REGOLE DROP (atteso: solo 10.0.0.3) ---')"
sh ovs-ofctl -O OpenFlow13 dump-flows s1 | grep -i drop
sh ovs-ofctl -O OpenFlow13 dump-flows s2 | grep -i drop
sh ovs-ofctl -O OpenFlow13 dump-flows s3 | grep -i drop
sh ovs-ofctl -O OpenFlow13 dump-flows s4 | grep -i drop
