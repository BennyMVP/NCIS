# =============================================================================
# ATTACCO DoS SINGOLO (label 1)
# Un SOLO host (h3) attacca h4 ad alto rate. A differenza del distribuito,
# qui c'e' una sola sorgente: il DoS classico da singolo attaccante.
# Sfondo lecito UDP concorrente (poche sorgenti a basso rate) per realismo.
# =============================================================================

# server vittima
h4 iperf3 -s > /tmp/h4_iperf_single.log 2>&1 &

# --- ATTACCANTE SINGOLO (h3) ad alto rate ---
h3 timeout 70 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 9999 --duration 60 --pps-min 250 --pps-max 450 --payload-min 600 --payload-max 1200 --start-delay 2 --burst-prob 0.20 --burst-min 30 --burst-max 80 > /tmp/h3_single_attack.log 2>&1 &

# --- traffico lecito concorrente (basso rate, poche sorgenti) ---
h1 timeout 70 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 8888 --duration 60 --pps-min 5 --pps-max 25 --payload-min 80 --payload-max 300 --start-delay 1 --burst-prob 0.03 > /tmp/h1_legit_single.log 2>&1 &
h2 timeout 70 python3 /tmp/udp_realistic_sender.py --dst 10.0.0.4 --port 8889 --duration 60 --pps-min 5 --pps-max 20 --payload-min 80 --payload-max 250 --start-delay 3 --burst-prob 0.02 > /tmp/h2_legit_single.log 2>&1 &
